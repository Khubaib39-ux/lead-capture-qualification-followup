    {
      "parameters": {
        "jsCode": "const leads = $('Check Replies').all().map(i => i.json).filter(l => !l.replied);\nconst templates = $('Get Templates').all().map(i => i.json);\n\nconst maxStage = Math.max(...templates.map(t => Number(t.stage)));\n\nconst out = [];\n\nfor (const lead of leads) {\n  const count = Number(lead.followup_count || 0);\n  const stage = count + 1;\n  const tpl = templates.find(t => Number(t.stage) === stage);\n  if (!tpl) continue;\n\n  const fill = (s) => String(s ?? '')\n    .replaceAll('\\\\n', '\\n')\n    .replaceAll('{{name}}', lead.name)\n    .replaceAll('{{service}}', lead.service);\n\n  const isLast = stage >= maxStage;\n  const days = Number(tpl.days_until_next);\n\n  if (!isLast && (!Number.isFinite(days) || days <= 0)) {\n    throw new Error(`Template stage ${stage}: days_until_next missing or invalid`);\n  }\n\n  out.push({\n    json: {\n      email: lead.email,\n      subject: fill(tpl.subject),\n      body: fill(tpl.body),\n      new_count: stage,\n      next_followup_at: isLast ? '' : $now.plus({ days }).toISO(),\n      new_status: isLast ? 'Closed' : 'Contacted'\n    }\n  });\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
