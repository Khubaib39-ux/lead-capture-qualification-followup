    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst norm = (s) => String(s ?? '').trim().toLowerCase();\n\nreturn $input.all().filter(item => {\n  const r = item.json;\n  if (!r.next_followup_at) return false;\n\n  const due = new Date(r.next_followup_at);\n  if (isNaN(due)) return false;\n\n  return (\n    norm(r.lead_status) === 'contacted' &&\n    norm(r.reply_recieved) !== 'yes' &&\n    due <= now &&\n    Number(r.followup_count || 0) < 3\n  );\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "b5508c31-9458-43bc-89ea-ae2ccc0ab677",
