      "parameters": {
        "jsCode": "const leads = $('Find Due Leads').all().map(i => i.json);\nconst msgs = $('Get Recent Inbox').all().map(i => i.json).filter(m => m.id);\n\nconst norm = (s) => String(s ?? '').trim().toLowerCase();\nconst senders = msgs.map(m => norm(JSON.stringify(m.From ?? m.from ?? m)));\n\nreturn leads.map(lead => {\n  const email = norm(lead.email);\n  const replied = senders.some(s => s.includes(email));\n  return { json: { ...lead, replied } };\n});"
      },
